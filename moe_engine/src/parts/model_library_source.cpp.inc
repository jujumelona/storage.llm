    s << "static float moe_model_fp16_to_f32(uint16_t h) {\n";
    s << "    const uint32_t sign = (uint32_t)(h & 0x8000u) << 16;\n";
    s << "    int exp = (int)((h >> 10) & 0x1fu);\n";
    s << "    uint32_t mant = (uint32_t)h & 0x03ffu;\n";
    s << "    uint32_t out;\n";
    s << "    if (exp == 0) {\n";
    s << "        if (mant == 0) {\n";
    s << "            out = sign;\n";
    s << "        } else {\n";
    s << "            exp = 1;\n";
    s << "            while ((mant & 0x0400u) == 0) {\n";
    s << "                mant <<= 1;\n";
    s << "                --exp;\n";
    s << "            }\n";
    s << "            mant &= 0x03ffu;\n";
    s << "            out = sign | ((uint32_t)(exp + 112) << 23) | (mant << 13);\n";
    s << "        }\n";
    s << "    } else if (exp == 31) {\n";
    s << "        out = sign | 0x7f800000u | (mant << 13);\n";
    s << "    } else {\n";
    s << "        out = sign | ((uint32_t)(exp + 112) << 23) | (mant << 13);\n";
    s << "    }\n";
    s << "    float f;\n";
    s << "    memcpy(&f, &out, sizeof(f));\n";
    s << "    return f;\n";
    s << "}\n";
    s << "\n";
    s << "static float moe_model_bf16_to_f32(uint16_t b) {\n";
    s << "    uint32_t out = (uint32_t)b << 16;\n";
