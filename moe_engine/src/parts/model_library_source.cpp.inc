    s << "#if defined(_WIN32)\n";
    s << "        HMODULE h = LoadLibraryA(names[i]);\n";
    s << "        if (h) return (void*)h;\n";
    s << "#else\n";
    s << "        void* h = dlopen(names[i], RTLD_NOW | RTLD_LOCAL);\n";
    s << "        if (h) return h;\n";
    s << "#endif\n";
    s << "    }\n";
    s << "    return 0;\n";
    s << "}\n";
    s << "\n";
    s << "static void* moe_model_sym(void* lib, const char* name) {\n";
    s << "    if (!lib || !name) return 0;\n";
    s << "#if defined(_WIN32)\n";
    s << "    return (void*)GetProcAddress((HMODULE)lib, name);\n";
    s << "#else\n";
    s << "    return dlsym(lib, name);\n";
    s << "#endif\n";
    s << "}\n";
    s << "\n";
