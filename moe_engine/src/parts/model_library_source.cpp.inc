    s << "        return 1;\n";
    s << "    }\n";
    s << "    if (format == moe_MODEL_WEIGHT_GGUF_Q8_0) {\n";
    s << "        const uint32_t blocks = (cols + 31u) / 32u;\n";
    s << "        for (uint32_t block = 0; block < blocks; ++block) {\n";
    s << "            const uint8_t* b = row + (size_t)block * 34u;\n";
