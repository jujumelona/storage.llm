    s << ") {\n";
    s << "    if (!row || !out || cols == 0) return 0;\n";
    s << "    if (format == moe_MODEL_WEIGHT_RAW_FP32) {\n";
    s << "        memcpy(out, row, (size_t)cols * sizeof(float));\n";
